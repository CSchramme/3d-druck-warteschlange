# Kopiere diese Datei nach .env und trag deine Werte ein.

# Pflicht: Passwort für den Admin-Bereich (/admin).
ADMIN_PASSWORD=bitte-aendern

# Optional, aber empfohlen: Die Familie muss dieses Passwort einmal pro Gerät
# eingeben, bevor sie Aufträge sehen oder einreichen kann. Leer = offen für alle.
FAMILY_PASSWORD=

# Discord-Webhook des Kanals, in den die nächsten Aufträge sollen
# (Kanal bearbeiten -> Integrationen -> Webhooks -> Neuer Webhook -> URL kopieren).
DISCORD_WEBHOOK_URL=

# Wie viele Aufträge von oben an Discord gemeldet werden.
DISCORD_TOP_N=3

# Optional: Adresse, unter der die Seite erreichbar ist. Dann steht in jeder
# Discord-Nachricht ein Link zum Admin-Bereich.
PUBLIC_URL=

# Optional: auf "true" setzen, wenn die Seite nur über HTTPS erreichbar ist.
COOKIE_SECURE=false

# Optional: Titel und Vorschaubild automatisch von MakerWorld laden.
FETCH_MAKERWORLD_INFO=true

# Optional: Zeitzone für die Anzeige.
TIMEZONE=Europe/Berlin

# Optional: fester Schlüssel für Login-Cookies. Ohne wird einer erzeugt und
# im Datenordner gespeichert.
# SECRET_KEY=
