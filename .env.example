# Diese Werte trägst du am einfachsten in Plesk ein:
#   Node.js → „Benutzerdefinierte Umgebungsvariablen“.
# Alternativ: Datei als ".env" (ohne .example) speichern und ausfüllen.
# Werte aus Plesk haben Vorrang vor der .env-Datei.

# Einrichtungs-Code für das erste Konto (/admin/einrichten). Danach werden
# Konten mit Benutzername und Passwort genutzt; das hier kann dann weg.
ADMIN_PASSWORD=bitte-aendern

# Spam-Schutz der offenen Startseite: so viele Sekunden muss das Formular offen
# sein, so viele Anfragen dürfen höchstens gleichzeitig auf Freigabe warten …
# MIN_FORM_SECONDS=2
# MAX_PENDING=50
# Höchstens so viele neue Anfragen pro Minute und Besucher (Standard: 5).
# MAX_ANFRAGEN_PRO_MINUTE=5

# Discord – am schönsten mit einem Bot: Nachrichten werden dann bearbeitet statt
# neu geschickt, mit eigenen Symbolen. Token aus dem Developer Portal
# (https://discord.com/developers/applications -> deine App -> Bot -> Reset Token).
# Wie ein Passwort behandeln und niemals auf GitHub hochladen!
DISCORD_BOT_TOKEN=

# Kanal für die Warteschlange (Entwicklermodus an, Rechtsklick auf den Kanal ->
# Kanal-ID kopieren). Kann leer bleiben, wenn DISCORD_WEBHOOK_URL gesetzt ist –
# dann nimmt der Bot den Kanal dieses Webhooks.
DISCORD_CHANNEL_ID=
# Optional: eigener Kanal für neue Anfragen (sonst derselbe wie oben).
# DISCORD_CHANNEL_ID_ANFRAGEN=

# Ohne Bot: Discord-Webhook des Kanals, in den die nächsten Aufträge sollen
# (Kanal bearbeiten -> Integrationen -> Webhooks -> Neuer Webhook -> URL kopieren).
# Jede Änderung ist dann eine neue Nachricht. Wie ein Passwort behandeln!
DISCORD_WEBHOOK_URL=

# Optional: eigener Webhook für neue Anfragen (sonst derselbe wie oben).
DISCORD_WEBHOOK_URL_ANFRAGEN=

# Optional: deine Discord-Benutzer-ID. Dann wirst du bei neuen Anfragen
# angepingt (Einstellungen -> Erweitert -> Entwicklermodus, dann Rechtsklick
# auf dich -> Benutzer-ID kopieren).
DISCORD_PING_USER_ID=

# Datenbank (MariaDB/MySQL). Ohne diese Angaben speichert die App in Dateien
# im Ordner "data". Die Tabellen legt die App beim ersten Start selbst an.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# Optional: Socket statt Netzwerk, z. B. /var/run/mysqld/mysqld.sock
# DB_SOCKET=
# Optional: Vorsilbe für die Tabellennamen (Standard: druck_)
# DB_TABLE_PREFIX=druck_

# Wie viele Aufträge von oben an Discord gemeldet werden (1 bis 9).
DISCORD_TOP_N=3

# Empfohlen: Adresse der Seite, z. B. https://druck.deine-domain.de – dann
# kommst du aus jeder Discord-Nachricht mit einem Klick zur Freigabe.
PUBLIC_URL=

# Auf "true" setzen, sobald die Seite über HTTPS läuft (in Plesk: SSL/TLS).
COOKIE_SECURE=false

# Titel und Vorschaubild automatisch von MakerWorld laden.
FETCH_MAKERWORLD_INFO=true

# Zeitzone für die Anzeige.
TIMEZONE=Europe/Berlin

# Ordner für die Daten (Standard: "data" im App-Ordner).
# DATA_DIR=data
